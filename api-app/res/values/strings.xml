    <string name="msg_display_over_other_apps_permission_not_granted_warning">The display over other apps permission should be granted to Termux:API app for starting foreground activities from background. Check https://developer.android.com/guide/components/activities/background-starts for more info.</string>
    <string name="msg_enabling_launcher_icon">Enabling %1$s app launcher icon</string>
