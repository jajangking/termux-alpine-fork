#!/data/data/com.termux.alpine/files/usr/bin/sh
BASE=/data/data/com.termux.alpine/files
PRE=$BASE/usr
FIX=$BASE/fix
DEST=$PRE/var/lib/proot-distro/installed-rootfs
ROOT=$DEST/alpine

mkdir -p "$HOME/.termux" "$FIX" "$ROOT"

if [ ! -f "$HOME/.termux/shell" ]; then
cat > "$HOME/.termux/shell" <<'ENDWRAP'
#!/data/data/com.termux.alpine/files/usr/bin/bash
PREFIX=/data/data/com.termux.alpine/files/usr
export LD_LIBRARY_PATH=$PREFIX/lib
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PREFIX/bin:/system/bin
export TMPDIR=$PREFIX/tmp
export PROOT_TMP_DIR=$PREFIX/tmp
export PROOT_LOADER=$PREFIX/libexec/proot/loader
unset LD_PRELOAD
R=$PREFIX/var/lib/proot-distro/installed-rootfs/alpine
exec "$PREFIX/bin/proot" -0 -r "$R" -b /dev -b /proc -b /sys -b "$R/tmp:/tmp" -b "$HOME:/root" -b /sdcard:/sdcard -b "$PREFIX:$PREFIX" -b /system -w /root /bin/sh -c 'unset LD_LIBRARY_PATH LD_PRELOAD; export HOME=/root; exec /bin/sh -l'
ENDWRAP
chmod 0700 "$HOME/.termux/shell"
fi

if [ ! -x "$PRE/bin/proot" ] && [ -f "$FIX/proot.tar.gz" ]; then
  tar -xzf "$FIX/proot.tar.gz" -C "$PRE"
fi

if [ ! -x "$ROOT/bin/busybox" ] && [ -f "$FIX/rootfs-mini.tar.gz" ]; then
  tar -xzf "$FIX/rootfs-mini.tar.gz" -C "$ROOT"
fi

if [ ! -f "$FIX/.api-cli5" ] && [ -f "$FIX/api-cli.tar.gz" ]; then
  tar -xzf "$FIX/api-cli.tar.gz" -C "$PRE"
  chmod 0755 "$PRE"/bin/termux-* "$PRE"/libexec/termux-api "$PRE"/bin/alpine-backup "$PRE"/bin/alpine-restore 2>/dev/null
  touch "$FIX/.api-cli5"
fi

if [ -f "$HOME/.termux/restore.tar.gz" ] && [ ! -f "$FIX/.restored" ]; then
  printf '=== restore %s ===\n' "$(date '+%F %T')" >>"$FIX/restore.log"
  rm -rf "$ROOT"
  mkdir -p "$ROOT"
  case "$HOME/.termux/restore.tar.gz" in
    *.zst|*.tar.zst) tar --zstd -xf "$HOME/.termux/restore.tar.gz" -C "$ROOT" 2>/dev/null ;;
    *) tar -xzf "$HOME/.termux/restore.tar.gz" -C "$ROOT" 2>/dev/null ;;
  esac
  mv "$HOME/.termux/restore.tar.gz" "$HOME/.termux/restore-done-$(date '+%s').tar.gz"
  touch "$FIX/.restored"
fi

if [ -x "$ROOT/bin/busybox" ]; then
  if [ ! -f "$ROOT/etc/resolv.conf" ]; then
    printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > "$ROOT/etc/resolv.conf"
  fi
  if [ ! -f "$ROOT/etc/apk/repositories" ]; then
    printf '%s\n' \
      https://dl-cdn.alpinelinux.org/alpine/v3.20/main \
      https://dl-cdn.alpinelinux.org/alpine/v3.20/community \
      > "$ROOT/etc/apk/repositories"
  fi
  if [ ! -x "$ROOT/usr/bin/curl" ] && [ -x "$PRE/bin/proot" ]; then
    printf '=== provision %s ===\n' "$(date '+%F %T')" >>"$FIX/provision.log"
    "$PRE/bin/proot" -0 -r "$ROOT" -b /dev -b /proc -b /sys \
      /bin/sh -c 'unset LD_LIBRARY_PATH LD_PRELOAD; export HOME=/root; apk update; apk add --no-cache bash curl git ripgrep python3 make libffi-dev gcompat libc6-compat zstd pv' \
      >>"$FIX/provision.log" 2>&1
    touch "$FIX/.provisioned"
  fi

  if [ -f "$ROOT/etc/profile" ] && ! grep -q "ALPINE_COLOR_PS1" "$ROOT/etc/profile"; then
    ESC=$(printf '\033')
    printf 'PS1="%s[1;36m\\h%s[0m:\\w\\$ "\n' "$ESC" "$ESC" >> "$ROOT/etc/profile"
    printf '# ALPINE_COLOR_PS1\n' >> "$ROOT/etc/profile"
  fi
  if [ -f "$ROOT/etc/profile" ] && ! grep -q "$PRE/bin:/system/bin" "$ROOT/etc/profile"; then
    printf '\nexport PATH="$PATH:%s/bin:/system/bin"\n' "$PRE" >> "$ROOT/etc/profile"
  fi
fi

export LD_LIBRARY_PATH=$PRE/lib
exec "$HOME/.termux/shell" -l "$@"